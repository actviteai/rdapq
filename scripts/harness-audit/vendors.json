        {
          "id": "repo-instructions",
          "installer": "copilot-instructions.md",
          "docs": "copilot-instructions.md",
          "readme": ".github/copilot-instructions.md"
        },
        {
          "id": "user-skill",
          "installer": "path.join(layout.copilot, 'skills', 'rdap-q')",
          "docs": ".github/skills",
          "readme": "~/.copilot/skills/rdap-q/"
