{
  "name": "@actvite/rdapq",
  "version": "2.1.0",
  "description": "Research-Driven Adaptive Planning with Quality Gates (RDAP-Q) — evidence-first protocol and skill for AI coding agents. A bundled tool runs the checks and names the result, so the model never grades itself. Codex, Grok, Copilot, Antigravity, Goose, Claude, Cline, and Cursor.",
  "main": "rdap-q-skill/SKILL.md",
  "bin": {
    "rdapq": "bin/rdapq.js",
    "rdap-q": "bin/rdapq.js",
    "rdapq-install": "bin/rdapq.js"
  },
  "author": {
    "name": "coldcanuk",
    "email": "chuck@actvite.com",
    "url": "https://actvite.com"
  },
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/actviteai/rdapq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actviteai/rdapq.git"
  },
  "bugs": {
    "url": "https://github.com/actviteai/rdapq/issues"
  },
  "keywords": [
    "rdap-q",
    "rdapq",
    "ai-agent",
    "coding-agent",
    "agent-skills",
    "quality-gates",
    "evidence-first",
    "claude-code",
    "codex",
    "cursor"
  ],
  "scripts": {
    "start": "node bin/rdapq.js",
    "init": "node bin/rdapq.js init",
    "status": "node bin/rdapq.js status",
    "test": "node scripts/check-versions.js && node scripts/check-static.js && node --test --test-concurrency=1 test/*.js",
    "check": "node scripts/check-versions.js && node scripts/check-static.js",
    "stamp": "node scripts/stamp-version.js",
    "version": "node scripts/stamp-version.js --git-add && node scripts/sync-integrations.js && git add integrations plugins/rdap-q/skills AGENTS.md CLAUDE.md GEMINI.md bridges .github/copilot-instructions.md",
    "sync": "node scripts/sync-integrations.js",
    "install:all": "node bin/rdapq.js install --all",
    "install:claude": "node bin/rdapq.js install --claude",
    "install:cline": "node bin/rdapq.js install --cline",
    "install:copilot": "node bin/rdapq.js install --copilot",
    "install:antigravity": "node bin/rdapq.js install --antigravity",
    "install:codex": "node bin/rdapq.js install --codex",
    "install:grok": "node bin/rdapq.js install --grok",
    "install:goose": "node bin/rdapq.js install --goose",
    "install:cursor": "node bin/rdapq.js install --cursor",
    "audit:harnesses": "python3 scripts/harness-audit/check.py"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "rdap-q-skill",
    "plugin.json",
    "install.sh",
    "install.ps1",
    "bridges",
    "lib",
    "scripts/*.js",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".claude-plugin",
    ".github/copilot-instructions.md",
    "plugins",
    "SECURITY.md"
  ]
}
